# Copia este archivo como .env.production. No escribas secretos en el archivo.
COMPOSE_PROJECT_NAME=gestorconta-production
POSTGRES_DB=gestorconta
POSTGRES_USER=gestorconta
POSTGRES_PASSWORD_FILE=./secrets/postgres_password
AUTH_CSRF_SECRET_FILE=./secrets/auth_csrf_secret
BOOTSTRAP_ADMIN_PASSWORD_FILE=./secrets/bootstrap_admin_password

# Nombre o IP que usa el navegador, sin ruta. El certificado debe cubrirlo.
PUBLIC_ORIGIN=https://gestorconta.local
PUBLIC_HTTPS_PORT=443
TLS_CERT_FILE=./secrets/tls.crt
TLS_KEY_FILE=./secrets/tls.key

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=

# Ajustes conservadores para Intel N95 / 8 GB RAM.
DB_POOL_MAX=8
HTTP_SHUTDOWN_TIMEOUT_MS=15000
