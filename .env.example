STORAGE_DRIVER=json
GESTORCONTA_DATA_DIR=

# PostgreSQL. Todos los valores son ficticios y deben reemplazarse localmente.
DATABASE_URL=postgresql://usuario_de_ejemplo:contrasena_de_ejemplo@127.0.0.1:5432/nombre_base_de_ejemplo
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nombre_base_de_ejemplo
DB_USER=usuario_de_ejemplo
DB_PASSWORD=contrasena_de_ejemplo
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_POOL_IDLE_MS=10000
DB_POOL_CONNECTION_TIMEOUT_MS=10000
DB_MIGRATIONS_TABLE=schema_migrations
DB_AUTO_INIT=false

# Desarrollo y semillas locales. Nunca se crean usuarios demo con NODE_ENV=production.
NODE_ENV=development
PORT=4000
DEV_SEED_PASSWORD=clave_local_ficticia_no_usar

# La API actualmente no expone una variable de origen frontend permitido.
# API_BASE_URL y WEB_BASE_URL se usan solamente en la suite de pruebas aislada.
API_BASE_URL=http://127.0.0.1:4000
WEB_BASE_URL=http://127.0.0.1:3000

# Autenticacion y sesiones
AUTH_SESSION_TTL_MS=43200000
AUTH_SCRYPT_MAX_CONCURRENCY=2
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_FAILURE_WINDOW_MS=900000
AUTH_LOGIN_LOCK_BASE_MS=30000
AUTH_LOGIN_LOCK_MAX_MS=900000
AUTH_LOGIN_MAX_TRACKED_KEYS=5000
AUTH_LOGIN_REMOTE_MAX_FAILURES=20
AUTH_LOGIN_REMOTE_FAILURE_WINDOW_MS=900000
AUTH_LOGIN_REMOTE_LOCK_BASE_MS=60000
AUTH_LOGIN_REMOTE_LOCK_MAX_MS=900000
AUTH_LOGIN_REMOTE_MAX_TRACKED_KEYS=2000
AUTH_LOGIN_GLOBAL_MAX_FAILURES=100
AUTH_LOGIN_GLOBAL_FAILURE_WINDOW_MS=300000
AUTH_LOGIN_GLOBAL_LOCK_BASE_MS=30000
AUTH_LOGIN_GLOBAL_LOCK_MAX_MS=300000

# Limitador provisional para una sola instancia. Antes de escalar horizontalmente,
# mover contadores y bloqueos a un almacen compartido.
