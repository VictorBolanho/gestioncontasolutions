{
  "name": "gestorconta",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "node apps/api/src/server.js",
    "dev:web": "node apps/web/server.js",
    "start:api": "node apps/api/src/server.js",
    "start:web": "node apps/web/server.js",
    "db:migrate": "node scripts/db-migrate.js",
    "db:init:deployment": "node scripts/db-initialize-deployment.js",
    "db:migrate:rollback": "node scripts/db-migrate-rollback.js",
    "db:seed": "node scripts/db-seed.js technical",
    "db:seed:demo": "node scripts/db-seed.js demo",
    "db:reset:test": "node scripts/db-reset-test.js",
    "db:migrate-json": "node scripts/db-migrate-json.js",
    "db:migrate-json:dry-run": "node scripts/db-migrate-json.js --dry-run",
    "db:bootstrap-admin": "node scripts/bootstrap-first-admin.js",
    "test": "node scripts/run-all-tests.js",
    "test:db": "node scripts/test-db.js",
    "test:auth-security": "node --test scripts/auth-security-test.js",
    "test:security-hardening": "node --test scripts/security-hardening-test.js",
    "test:security-network": "node --test scripts/security-network-test.js",
    "test:browser-session": "node --test scripts/browser-session-security-test.js",
    "test:web-deployment-security": "node --test scripts/web-deployment-security-test.js",
    "test:async-infrastructure": "node scripts/run-async-infrastructure-test.js",
    "test:seed": "node --test scripts/seed-atomicity-test.js",
    "test:calendar-migration": "node --test scripts/calendar-migration-test.js",
    "test:postgres-calendar": "node scripts/postgres-calendar-migration-test.js",
    "test:postgres-reconcile": "node scripts/postgres-full-reconciliation-test.js",
    "test:postgres-bootstrap-admin": "node scripts/run-isolated-postgres-http-test.js --bootstrap-only",
    "test:postgres-bootstrap-admin:internal": "node --test scripts/postgres-first-admin-bootstrap-test.js",
    "test:database-http:docker": "node scripts/run-isolated-postgres-http-test.js",
    "smoke:test": "node scripts/smoke-test.js",
    "reset:dev-data": "node scripts/reset-dev-data.js --confirm",
    "reset:fiscal-data": "node scripts/reset-fiscal-data.js --confirm"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
