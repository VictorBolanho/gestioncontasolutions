# Datos locales de desarrollo
# No subir empresas, RUT, auditorías ni PDFs reales
apps/api/data/*.json
apps/api/data/uploads/
apps/api/data/uploads/rut/

# Mantener estructura si usas .gitkeep
!apps/api/data/.gitkeep
!apps/api/data/uploads/.gitkeep
!apps/api/data/uploads/rut/.gitkeep

# PDFs/RUT de prueba o reales en raíz
*.pdf

# Exportaciones y temporales locales
exports/
tmp/
temp/
*.tmp
*.temp
.eslintcache
.parcel-cache/
.turbo/
